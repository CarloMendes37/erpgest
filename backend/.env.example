# ─────────────────────────────────────────────────────────
#  ERP Gest — Environment Variables
#  Copy to .env.local for local development
# ─────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MariaDB / MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=erpgest
DB_PASS=erpgest_secret
DB_NAME=erpgest
DB_SYNC=true
DB_LOGGING=false

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=7d
